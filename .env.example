# ORACHIN Paints — Environment Variables Template
# Copy to .env.local for local development. Never commit real keys.

# Application Environment
NODE_ENV=development
APP_ENV=development

# Decision Gates & Indexing Control (off by default)
ALLOW_SEARCH_INDEXING=false

# Supabase Platform (Backend integration - Phase 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scheduled Jobs Secret (Header-authenticated runner endpoints)
JOB_RUNNER_SECRET=

# Email & Notifications (Provider deferred until G10)
NOTIFICATION_ALERT_EMAIL=
